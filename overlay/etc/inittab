# /etc/inittab - GullOS BusyBox Init Configuration

::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mount -o remount,rw /
::sysinit:/bin/mkdir -p /dev/pts /dev/shm /run /tmp /var/log /var/lock/subsys
::sysinit:/bin/mount -a
::sysinit:/bin/hostname -F /etc/hostname
::sysinit:/etc/init.d/rcS

# tty1: Automatic Wayland desktop session for `gull` (starts gull-lock immediately)
tty1::respawn:/sbin/agetty --autologin gull --noclear 38400 tty1 linux

# tty2..tty4: Raw Linux Virtual Consoles (demonstrates gull-term TTY fallback)
tty2::respawn:/sbin/agetty --noclear 38400 tty2 linux
tty3::respawn:/sbin/agetty --noclear 38400 tty3 linux
tty4::respawn:/sbin/agetty --noclear 38400 tty4 linux

# Serial console for headless debugging if ttyS0 is present
ttyS0::respawn:/sbin/agetty -L 115200 ttyS0 vt100

::ctrlaltdel:/sbin/reboot
::shutdown:/etc/init.d/rcK
::shutdown:/sbin/swapoff -a
::shutdown:/bin/umount -a -r
