#!/bin/sh
# /usr/bin/gull-session
# Launches the pure Wayland desktop session (Plasma 6 + GullDesk)
set -eu

UID_NUM="$(id -u)"
export USER="${USER:-gull}"
export HOME="${HOME:-/home/gull}"
export SHELL="/usr/bin/gull-sh"
export XDG_RUNTIME_DIR="/run/user/${UID_NUM}"
export XDG_CONFIG_HOME="${HOME}/.config"
export XDG_CACHE_HOME="${HOME}/.cache"
export XDG_DATA_HOME="${HOME}/.local/share"
export XDG_SESSION_TYPE="wayland"
export XDG_CURRENT_DESKTOP="KDE"
export XDG_SESSION_DESKTOP="plasma"

export MOZ_ENABLE_WAYLAND=1
export GDK_BACKEND=wayland
export SDL_VIDEODRIVER=wayland
export COLORTERM=truecolor
export QT_QPA_PLATFORM="wayland;xcb"
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1

mkdir -p "${XDG_RUNTIME_DIR}" "${XDG_CONFIG_HOME}" "${XDG_CACHE_HOME}" "${XDG_DATA_HOME}"
chmod 0700 "${XDG_RUNTIME_DIR}" 2>/dev/null || true

if grep -qw "gullos.tty=1" /proc/cmdline 2>/dev/null; then
    echo "[gull-session] Kernel requested raw TTY console mode; delegating to gull-term..."
    exec /usr/bin/gull-term
fi

if [ -x /usr/bin/gull-term ] && [ -z "${WAYLAND_DISPLAY:-}" ] && [ "$(tty 2>/dev/null || true)" != "/dev/tty1" ]; then
    exec /usr/bin/gull-term
fi

if command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session -- startplasma-wayland
else
    exec startplasma-wayland
fi