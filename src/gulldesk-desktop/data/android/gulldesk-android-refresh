if [ "${1:-}" = check ]; then
    exec /usr/libexec/gulldesk-android graphics-check
fi
if [ "${1:-}" = wayland ]; then
    exec /usr/libexec/gulldesk-android use-wayland
fi
exec /usr/libexec/gulldesk-android refresh
