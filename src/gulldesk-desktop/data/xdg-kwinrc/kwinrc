[org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=__aurorae__svg__gulldesk
BorderSize=None
BorderSizeAuto=false
ButtonsOnLeft=M
ButtonsOnRight=IAX

[TabBox]
LayoutName=org.gulldesk.switcher

[TabBoxAlternative]
LayoutName=org.gulldesk.switcher

[Round-Corners]
Size=12
InactiveCornerRadius=12
UseSquircleShape=false
UseNativeDecorationShadows=false
OutlineThickness=1
InactiveOutlineThickness=1
ActiveOutlineUseCustom=true
InactiveOutlineUseCustom=true
OutlineColor=255,255,255
InactiveOutlineColor=255,255,255
ActiveOutlineAlpha=40
InactiveOutlineAlpha=28
SecondOutlineThickness=0
InactiveSecondOutlineThickness=0
OuterOutlineThickness=0
InactiveOuterOutlineThickness=0
Exclusions=org.gulldesk.appgroup,org.gulldesk.appsplash,org.gulldesk.androiddialog,org.gulldesk.apkinstaller,org.gulldesk.screenshot

[Effect-overview]
BlurBackground=true
