 "script": "// GullDesk boot splash. Generated by tools/gen-plymouth-theme.\n\nWindow.SetBackgroundTopColor(@BG@);\nWindow.SetBackgroundBottomColor(@BG@);\n\nscreen.x = Window.GetX();\nscreen.y = Window.GetY();\nscreen.w = Window.GetWidth();\nscreen.h = Window.GetHeight();\n\n// --- the mark ---------------------------------------------------------------\n\nlogo.image = Image(\"logo.png\");\nlogo.sprite = Sprite(logo.image);\nlogo.sprite.SetX(screen.x + screen.w / 2 - logo.image.GetWidth() / 2);\nlogo.sprite.SetY(screen.y + screen.h * 0.42 - logo.image.GetHeight() / 2);\nlogo.sprite.SetOpacity(0);\n\n// --- the loading indicator ---------------------------------------------------\n\nshape_count = 7;\nfor (i = 0; i < shape_count; i++)\n    shapes[i] = Image(\"shape-\" + i + \".png\");\n\nwave_count = 90;\nfor (i = 0; i < wave_count; i++)\n    waves[i] = Image(\"wave-\" + i + \".png\");\n\nindicator.x = screen.x + screen.w / 2;\nindicator.y = screen.y + screen.h * 0.42 + logo.image.GetHeight() / 2 + 72;\nindicator.sprite = Sprite();\nindicator.sprite.SetZ(10);\nindicator.sprite.SetX(indicator.x - waves[0].GetWidth() / 2);\nindicator.sprite.SetY(indicator.y - waves[0].GetHeight() / 2);\nindicator.sprite.SetOpacity(0);\ntick = 0;\n\nfun refresh_callback() {\n    tick++;\n    if (tick <= 25) {\n        logo.sprite.SetOpacity(tick / 25);\n        indicator.sprite.SetOpacity(tick / 25);\n    }\n    indicator.sprite.SetImage(waves[tick % wave_count]);\n}\nPlymouth.SetRefreshFunction(refresh_callback);\n\n// --- a passphrase or a question ------------------------------------------------\n\nentry.image = Image(\"entry.png\");\nentry.sprite = Sprite(entry.image);\nentry.x = screen.x + screen.w / 2 - entry.image.GetWidth() / 2;\nentry.y = screen.y + screen.h * 0.68;\nentry.sprite.SetX(entry.x);\nentry.sprite.SetY(entry.y);\nentry.sprite.SetOpacity(0);\nentry.sprite.SetZ(20);\n\nlock.image = Image(\"lock.png\");\nlock.sprite = Sprite(lock.image);\nlock.sprite.SetX(entry.x + 16);\nlock.sprite.SetY(entry.y + entry.image.GetHeight() / 2 - lock.image.GetHeight() / 2);\nlock.sprite.SetOpacity(0);\nlock.sprite.SetZ(21);\n\nbullet.size = 26;\nfor (i = 0; i < shape_count; i++)\n    bullet_shapes[i] = shapes[i].Scale(bullet.size, bullet.size);\nprompt.sprite = Sprite();\nprompt.sprite.SetZ(21);\nanswer.sprite = Sprite();\nanswer.sprite.SetZ(21);\nbullets = [];\nbullet_count = 0;\n\nfun hide_bullets() {\n    for (i = 0; i < bullet_count; i++)\n        bullets[i].SetOpacity(0);\n}\n\nfun show_prompt(text) {\n    prompt.image = Image.Text(text, @TEXT@, 1, \"Sans 12\");\n    prompt.sprite.SetImage(prompt.image);\n    prompt.sprite.SetX(screen.x + screen.w / 2 - prompt.image.GetWidth() / 2);\n    prompt.sprite.SetY(entry.y - prompt.image.GetHeight() - 16);\n    prompt.sprite.SetOpacity(1);\n    entry.sprite.SetOpacity(1);\n    lock.sprite.SetOpacity(1);\n}\n\nfun display_password_callback(text, count) {\n    show_prompt(text);\n    answer.sprite.SetOpacity(0);\n    hide_bullets();\n    // As many dots as fit the field.\n    fit = Math.Int((entry.image.GetWidth() - 72) / (bullet.size + 2));\n    if (count > fit)\n        count = fit;\n    for (i = 0; i < count; i++) {\n        if (!bullets[i])\n            bullets[i] = Sprite();\n        bullets[i].SetImage(bullet_shapes[i % shape_count]);\n        bullets[i].SetX(entry.x + 52 + i * (bullet.size + 2));\n        bullets[i].SetY(entry.y + entry.image.GetHeight() / 2 - bullet.size / 2);\n        bullets[i].SetZ(22);\n        bullets[i].SetOpacity(1);\n    }\n    if (count > bullet_count)\n        bullet_count = count;\n}\nPlymouth.SetDisplayPasswordFunction(display_password_callback);\n\nfun display_question_callback(text, value) {\n    show_prompt(text);\n    hide_bullets();\n    answer.image = Image.Text(value, @TEXT@, 1, \"Sans 12\");\n    answer.sprite.SetImage(answer.image);\n    answer.sprite.SetX(entry.x + 56);\n    answer.sprite.SetY(entry.y + entry.image.GetHeight() / 2 - answer.image.GetHeight() / 2);\n    answer.sprite.SetOpacity(1);\n}\nPlymouth.SetDisplayQuestionFunction(display_question_callback);\n\nfun display_normal_callback() {\n    prompt.sprite.SetOpacity(0);\n    answer.sprite.SetOpacity(0);\n    entry.sprite.SetOpacity(0);\n    lock.sprite.SetOpacity(0);\n    hide_bullets();\n}\nPlymouth.SetDisplayNormalFunction(display_normal_callback);\n\n// --- messages -----------------------------------------------------------------\n\nmessage.sprite = Sprite();\nmessage.sprite.SetZ(30);\n\nfun message_callback(text) {\n    message.image = Image.Text(text, @SOFT@, 1, \"Sans 10\");\n    message.sprite.SetImage(message.image);\n    message.sprite.SetX(screen.x + screen.w / 2 - message.image.GetWidth() / 2);\n    message.sprite.SetY(screen.y + screen.h - message.image.GetHeight() - 48);\n}\nPlymouth.SetMessageFunction(message_callback);\n",
 "colours": {
  "@BG@": "surface",
  "@TEXT@": "surfaceContent",
  "@SOFT@": "surfaceVariantContent"
 }
}