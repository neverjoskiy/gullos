{"file":"wave-81.png","width":72,"height":72,"layers":[["","secondaryContainer"],["eNpjYBgFFAG2pC23r8wxp9QY45v/wWAOJ0XGeHz9DwVLKDHG+hvMmP9/2Mg3Ruk13Jj/rxnJNkbhFtiEc9aZX/7/iibXlPoPEIec5GVgEHGTIdcYX6h/7otRFuGNEGPealGYcDzAxjzSpzghl774da1RYDRDj4JRMApGwSgYBaNgFIyCUTAKRsEoGAWjAB0AAFg4WX8=","primary"]]},{"file":"wave-82.png","width":72,"height":72,"layers":[["","secondaryContainer"],["eNpjYBgFFAGDaRfu7M3lptAU1ol//4PAQ1uKjOHc+R8KfvhSYAzThv9w8E2VfHM6/yOBCrKNSfoH0v+r2OQIiE4i15hksDF/wxgYuPf8/3+Ig1xzXoC9UwliMppaMJFrDOMXkDHLGClOgb1AY1axUZ6SGeMnRzGOZuhRMApGwSgYBaNgFIyCUTAKRsEoGAWjYBSgAwADyVZV","primary"]]},{"file":"wave-83.png","width":72,"height":72,"layers":[["","secondaryContainer"],["eNpjYBgFlADu3N13L840otQYm4f/QeDfFHaKjPH98R8KdnNSYIzl9/9wsJ6JbGPEn/xHAhVkm7MSrP+oceEvEH2HbHM+grSf4GJgCP0LZJwj25xTQN0vpEGswn//v3uRbY7B/f+PLSFMrVA5CuKLWZplNCeOglEwCkbBKBgFo2AUjIJRMApGwSgYBaOAVgAAaSxSug==","primary"]]},{"file":"wave-84.png","width":72,"height":72,"layers":[["","secondaryContainer"],["eNpjYBgFlACLuZdvbk1mo9AU9tn//oPATSOKjOHc9x8KvnlQYs68/3Dw3YZ8Yzj+IMz5/1qZbHNYPgH1/8yyPgs26AoL2Qbl/vv/I5SBgfcE2CBr8n2mEyEPokTvgczRpjwVaT77/38uNZIjn5/laJ4cBaNgFIyCUTAKRsEoGAWjYBSMglEwCkYBdQEAMplOAA==","primary"]]},{"file":"wave-85.png","width":72,"height":72,"layers":[["","secondaryContainer"],["eNpjYBgFFACe3B3XD3eoUGqM5eP/IPCrkZkiYzhe/IeCjeyUmKPxHw7WUeIijlcIg6ZR4iDbaz/XWjb/BRvUx0hpaEdDDIqnOPYLwOYsoTwZtYHMqaFCeiz+8n8TFzUSNofIaOYeBaNgFIyCUTAKRsEoGAWjYBSMglEwCkYBBAAAt6RJ8w==","primary"]]},{"file":"wave-86.png","width":72,"height":72,"layers":[["","secondaryContainer"],["eNpjYBgFFADZyUdPLvJmpNQYzvv/QeCoCoXmuP6HgPd2lJmjDzXn/xdrygyaDjPovQFlBuk4BNwGG/Q6kNLAFjoDcVInpQaJXAOb84uHUoNkboHM+cNPcXIU3wk0ZyY1ErZjYzjTaPYeBaNgFIyCUTAKRsEoGAWjYBSMglEwCkYBCAAAtrFHAA==","primary"]]},{"file":"wave-87.png","width":72,"height":72,"layers":[["","secondaryContainer"],["eNpjYBgFlADLlWvzBSk3RuXb////P6RSbE7RfzCYzUyhOWEQc/4vp9Aglg1QgxZR6iLD+RCDtieLUmhS9j+ISa+UKDQoC2pQD6WxlgsxaDLF0e/7FGjMVz3K0yNHSEu9+mjuHgWjYBSMglEwCkbBKBgFo2AUjIJRMApGAQgAAB7iRPg=","primary"]]},{"file":"wave-88.png","width":72,"height":72,"layers":[["","secondaryContainer"],["eNpjYBgFFAF2WyVqGKNw//+/pcKUmzP7PxA80qPYnM0gc/6/M6XUnCiwOf/fW1BqUMwbsEHfFu5fqkaRQXLX/0PBY06KDBK/BjPIjjKviZ2FGPNXgcIw4uz/CTTmdznlyUgkLC1MYjRzj4JRMApGwSgYBaNgFIyCUTAKRsEoGAWjAAQAJexDpg==","primary"]]},{"file":"wave-89.png","width":72,"height":72,"layers":[["","secondaryContainer"],["eNpjYBgFgwM45xtQw5jm////1DJSbAz7j/9AMJOJUnM4f4HM+b+UncEgQY8SgyaCzfl/9cL//3/TKDCHqfU/HLykyGuF/2DmfKYsvBN+Qs3ppDCwjY6ATDkRS3n0K/l5So9myVEwCkbBKBgFo2AUjIJRMApGwSgYBaNgFIABAJRSQvU=","primary"]]},{"file":"lock.png","width":24,"height":24,"layers":[["eNqt0M0JgDAMBeBu0a4UL6Kz1Bl0LXWUdAQLvT2pP2AiKhTf5ZGv0JQa85FmjnFqbjxgS6+4RfLO+YRa+gyfq8MoPcLmslikA7JfvQq4JNDpggHWl+ipzKuwb9Qejo3a+cGJmf54z33ih38gccBkCrICbEyRWg==","surfaceVariantContent"]]}],"script":"// GullDesk boot splash. Generated by tools/gen-plymouth-theme.\n\nWindow.SetBackgroundTopColor(@BG@);\nWindow.SetBackgroundBottomColor(@BG@);\n\nscreen.x = Window.GetX();\nscreen.y = Window.GetY();\nscreen.w = Window.GetWidth();\nscreen.h = Window.GetHeight();\n\n// --- the mark ---------------------------------------------------------------\n\nlogo.image = Image(\"logo.png\");\nlogo.sprite = Sprite(logo.image);\nlogo.sprite.SetX(screen.x + screen.w / 2 - logo.image.GetWidth() / 2);\nlogo.sprite.SetY(screen.y + screen.h * 0.42 - logo.image.GetHeight() / 2);\nlogo.sprite.SetOpacity(0);\n\n// --- the loading indicator ---------------------------------------------------\n\nshape_count = 7;\nfor (i = 0; i < shape_count; i++)\n    shapes[i] = Image(\"shape-\" + i + \".png\");\n\nwave_count = 90;\nfor (i = 0; i < wave_count; i++)\n    waves[i] = Image(\"wave-\" + i + \".png\");\n\nindicator.x = screen.x + screen.w / 2;\nindicator.y = screen.y + screen.h * 0.42 + logo.image.GetHeight() / 2 + 72;\nindicator.sprite = Sprite();\nindicator.sprite.SetZ(10);\nindicator.sprite.SetX(indicator.x - waves[0].GetWidth() / 2);\nindicator.sprite.SetY(indicator.y - waves[0].GetHeight() / 2);\nindicator.sprite.SetOpacity(0);\ntick = 0;\n\nfun refresh_callback() {\n    tick++;\n    if (tick <= 25) {\n        logo.sprite.SetOpacity(tick / 25);\n        indicator.sprite.SetOpacity(tick / 25);\n    }\n    indicator.sprite.SetImage(waves[tick % wave_count]);\n}\nPlymouth.SetRefreshFunction(refresh_callback);\n\n// --- a passphrase or a question ------------------------------------------------\n\nentry.image = Image(\"entry.png\");\nentry.sprite = Sprite(entry.image);\nentry.x = screen.x + screen.w / 2 - entry.image.GetWidth() / 2;\nentry.y = screen.y + screen.h * 0.68;\nentry.sprite.SetX(entry.x);\nentry.sprite.SetY(entry.y);\nentry.sprite.SetOpacity(0);\nentry.sprite.SetZ(20);\n\nlock.image = Image(\"lock.png\");\nlock.sprite = Sprite(lock.image);\nlock.sprite.SetX(entry.x + 16);\nlock.sprite.SetY(entry.y + entry.image.GetHeight() / 2 - lock.image.GetHeight() / 2);\nlock.sprite.SetOpacity(0);\nlock.sprite.SetZ(21);\n\nbullet.size = 26;\nfor (i = 0; i < shape_count; i++)\n    bullet_shapes[i] = shapes[i].Scale(bullet.size, bullet.size);\nprompt.sprite = Sprite();\nprompt.sprite.SetZ(21);\nanswer.sprite = Sprite();\nanswer.sprite.SetZ(21);\nbullets = [];\nbullet_count = 0;\n\nfun hide_bullets() {\n    for (i = 0; i < bullet_count; i++)\n        bullets[i].SetOpacity(0);\n}\n\nfun show_prompt(text) {\n    prompt.image = Image.Text(text, @TEXT@, 1, \"Sans 12\");\n    prompt.sprite.SetImage(prompt.image);\n    prompt.sprite.SetX(screen.x + screen.w / 2 - prompt.image.GetWidth() / 2);\n    prompt.sprite.SetY(entry.y - prompt.image.GetHeight() - 16);\n    prompt.sprite.SetOpacity(1);\n    entry.sprite.SetOpacity(1);\n    lock.sprite.SetOpacity(1);\n}\n\nfun display_password_callback(text, count) {\n    show_prompt(text);\n    answer.sprite.SetOpacity(0);\n    hide_bullets();\n    // As many dots as fit the field.\n    fit = Math.Int((entry.image.GetWidth() - 72) / (bullet.size + 2));\n    if (count > fit)\n        count = fit;\n    for (i = 0; i < count; i++) {\n        if (!bullets[i])\n            bullets[i] = Sprite();\n        bullets[i].SetImage(bullet_shapes[i % shape_count]);\n        bullets[i].SetX(entry.x + 52 + i * (bullet.size + 2));\n        bullets[i].SetY(entry.y + entry.image.GetHeight() / 2 - bullet.size / 2);\n        bullets[i].SetZ(22);\n        bullets[i].SetOpacity(1);\n    }\n    if (count > bullet_count)\n        bullet_count = count;\n}\nPlymouth.SetDisplayPasswordFunction(display_password_callback);\n\nfun display_question_callback(text, value) {\n    show_prompt(text);\n    hide_bullets();\n    answer.image = Image.Text(value, @TEXT@, 1, \"Sans 12\");\n    answer.sprite.SetImage(answer.image);\n    answer.sprite.SetX(entry.x + 56);\n    answer.sprite.SetY(entry.y + entry.image.GetHeight() / 2 - answer.image.GetHeight() / 2);\n    answer.sprite.SetOpacity(1);\n}\nPlymouth.SetDisplayQuestionFunction(display_question_callback);\n\nfun display_normal_callback() {\n    prompt.sprite.SetOpacity(0);\n    answer.sprite.SetOpacity(0);\n    entry.sprite.SetOpacity(0);\n    lock.sprite.SetOpacity(0);\n    hide_bullets();\n}\nPlymouth.SetDisplayNormalFunction(display_normal_callback);\n\n// --- messages -----------------------------------------------------------------\n\nmessage.sprite = Sprite();\nmessage.sprite.SetZ(30);\n\nfun message_callback(text) {\n    message.image = Image.Text(text, @SOFT@, 1, \"Sans 10\");\n    message.sprite.SetImage(message.image);\n    message.sprite.SetX(screen.x + screen.w / 2 - message.image.GetWidth() / 2);\n    message.sprite.SetY(screen.y + screen.h - message.image.GetHeight() - 48);\n}\nPlymouth.SetMessageFunction(message_callback);\n","colours":{"@BG@":"surface","@TEXT@":"surfaceContent","@SOFT@":"surfaceVariantContent"}}