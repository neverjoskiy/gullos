    function loadColour() {
        if (tokens.colour === "gulldesk") {
            tokens.colourPalettes = null;
            return;
        }
        const file = StandardPaths.locate(StandardPaths.GenericDataLocation, "gulldesk/palettes/" + tokens.colour + ".conf");
        if (String(file).length === 0) {
            tokens.colourPalettes = null;
            return;
        }
        const reader = tokens.paletteReader.createObject(tokens, { location: file });
        const result = {};
        for (const generation of ["md1", "md2", "md3"]) {
            result[generation] = {};
            for (const mode of ["dark", "light"]) {
                const roles = {};
                for (const role of tokens.roleNames) {
                    const value = String(reader.value(generation + "-" + mode + "/" + role, ""));
                    roles[role] = value.length > 0 ? "#" + value : tokens.palettes[generation][mode][role];
                }
                result[generation][mode] = roles;
            }
        }
        reader.destroy();
        tokens.colourPalettes = result;
    }

