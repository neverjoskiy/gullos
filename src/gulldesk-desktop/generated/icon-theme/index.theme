[Icon Theme]
Name=GullDesk
Comment=GullDesk OS icons, drawn from Material Symbols Rounded
Inherits=breeze-dark,breeze,hicolor

Directories=scalable/actions,scalable/apps,scalable/categories,scalable/devices,scalable/emblems,scalable/mimetypes,scalable/places,scalable/status

Example=start-here-kde

[scalable/actions]
Size=24
MinSize=8
MaxSize=512
Context=Actions
Type=Scalable

[scalable/apps]
Size=24
MinSize=8
MaxSize=512
Context=Applications
Type=Scalable

