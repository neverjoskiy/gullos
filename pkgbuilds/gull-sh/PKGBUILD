# Maintainer: GullOS Contributors
pkgname=gull-sh
pkgver=0.1.0
pkgrel=1
pkgdesc="Catppuccin Mocha fish-like interactive shell for GullOS"
arch=('x86_64')
url="https://github.com/neverjoskiy/gullos"
license=('MIT')
makedepends=('cargo' 'rust')
source=()
options=('!lto')

build() {
    cd "$startdir/../../rust-workspace"
    cargo build --release -p gull-sh
}

package() {
    cd "$startdir/../../rust-workspace"
    install -Dm755 "target/release/gull-sh" "$pkgdir/usr/bin/gull-sh"
    install -Dm644 /dev/null "$pkgdir/etc/shells.gull-sh" 2>/dev/null || true
}
EOF
