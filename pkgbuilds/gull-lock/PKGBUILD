# Maintainer: GullOS Contributors
pkgname=gull-lock
pkgver=0.1.0
pkgrel=1
pkgdesc="GullOS Catppuccin Mocha Wayland lockscreen (ext-session-lock-v1)"
arch=('x86_64')
url="https://github.com/neverjoskiy/gullos"
license=('MIT')
depends=('wayland' 'mesa' 'libxkbcommon' 'ab_glyph' 'fontconfig')
makedepends=('cargo' 'rust')
source=()
options=('!lto')

build() {
    cd "$startdir/../../rust-workspace"
    cargo build --release -p gull-lock
}

package() {
    cd "$startdir/../../rust-workspace"
    install -Dm755 "target/release/gull-lock" "$pkgdir/usr/bin/gull-lock"
}
EOF
