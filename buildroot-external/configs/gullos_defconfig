# Architecture: x86_64 generic (compatible with VirtualBox & bare metal)
BR2_x86_64=y

# Toolchain: Buildroot glibc (ABI-aligned for Arch Linux binary packages)
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y

# System Identity & Merged /usr (MANDATORY for Arch pacman .pkg.tar.zst layout)
BR2_TARGET_GENERIC_HOSTNAME="gull-pc"
BR2_TARGET_GENERIC_ISSUE="GullOS 0.1.0 (x86_64 / Wayland / Catppuccin Mocha)"
BR2_TARGET_GENERIC_ROOT_PASSWD="gull"
BR2_ROOTFS_MERGED_USR=y
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_SYSTEM_BIN_SH_BASH=y
BR2_ENABLE_LOCALE_PURGE=n
BR2_GENERATE_LOCALE="en_US.UTF-8"

# Users, Rootfs Overlay & Build Hooks
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_GULLOS_PATH)/patches"
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_GULLOS_PATH)/board/gullos/users.txt"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_GULLOS_PATH)/../overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_GULLOS_PATH)/board/gullos/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_GULLOS_PATH)/board/gullos/post-image.sh"

# Linux Kernel 6.12 LTS with VirtualBox + Wayland KMS/DRM fragment
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12.17"
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_GULLOS_PATH)/board/gullos/linux.fragment"
BR2_LINUX_KERNEL_INSTALL_TARGET=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# Core System Utilities (NOTE: firefox, git, nano are installed via binary pacman, NEVER compiled here)
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BASH=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_DHCPCD=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_KBD=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_NCURSES_WCHAR=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_PARTED=y
BR2_PACKAGE_SHADOW=y
BR2_PACKAGE_SUDO=y
BR2_PACKAGE_TAR=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_LIBBLKID=y
BR2_PACKAGE_UTIL_LINUX_LIBMOUNT=y
BR2_PACKAGE_UTIL_LINUX_LIBSMARTCOLS=y
BR2_PACKAGE_UTIL_LINUX_LIBUUID=y
BR2_PACKAGE_UTIL_LINUX_MOUNT=y
BR2_PACKAGE_XZ=y
BR2_PACKAGE_ZSTD=y

# GullOS Custom Rust Userland
BR2_PACKAGE_GULL_SH=y
BR2_PACKAGE_GULL_TERM=y
BR2_PACKAGE_GULL_LOCK=y

# Rootfs Output (hydrated with binary pacman packages into .vdi and .iso)
BR2_TARGET_ROOTFS_TAR=y
# BR2_TARGET_ROOTFS_EXT2 is not set
